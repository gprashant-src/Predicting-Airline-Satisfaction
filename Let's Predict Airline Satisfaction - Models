")\n","\n","from sklearn.tree import DecisionTreeClassifier\n","from sklearn.ensemble import RandomForestClassifier, ExtraTreesClassifier\n","from xgboost import XGBClassifier\n","from lightgbm import LGBMClassifier\n","from catboost import CatBoostClassifier\n","\n","from imblearn.over_sampling import RandomOverSampler, SMOTE, SMOTENC\n"]},{"cell_type":"code","execution_count":10,"id":"67d765fa","metadata":{"execution":{"iopub.execute_input":"2026-10-03T17:11:01.054774Z","iopub.status.busy":"2026-10-03T17:11:01.053959Z","iopub.status.idle":"2026-10-03T17:11:01.064066Z","shell.execute_reply":"2026-10-03T17:11:01.063255Z"},"papermill":{"duration":0.016752,"end_time":"2026-10-03T17:11:01.066031+00:00","exception":false,"start_time":"2026-10-03T17:11:01.049279+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def evaluate_model(model, X_train, y_train, X_test, y_test, model_name=\"Classifier\"):\n","\n","    model.fit(X_train, y_train)\n","    y_pred = model.predict(X_test)\n","\n","    if hasattr(model, \"predict_proba\"):\n","        y_pred_prob = model.predict_proba(X_test)[:, 1]\n","    elif hasattr(model, \"decision_function\"):\n","        y_pred_prob = model.decision_function(X_test)\n","    else:\n","        y_pred_prob = None\n","\n","    acc = accuracy_score(y_test, y_pred)\n","    bal_acc = balanced_accuracy_score(y_test, y_pred)\n","    prec, recall, f1, _ = precision_recall_fscore_support(\n","        y_test, y_pred, average=\"binary\", zero_division=0\n","    )\n","    auc = (\n","        roc_auc_score(y_test, y_pred_prob) if y_pred_prob is not None else None\n","    )\n","\n","    print(classification_report(y_test, y_pred, zero_division=0))\n","    print(\"-\" * 40)\n","\n","    fig, ax = plt.subplots(figsize=(4.5, 3))\n","    ConfusionMatrixDisplay.from_predictions(\n","        y_test, y_pred, display_labels=[\"No\", \"Yes\"], ax=ax\n","    )\n","    ax.grid(False)\n","    plt.title(f\"Confusion Matrix - {model_name}\")\n","    plt.show()\n","\n","    print(\"ROC-AUC score:\", auc)\n","\n","    metrics = {\n","        \"Model/Condition\": model_name,\n","        \"Acc.\": round(acc, 4),\n","        \"Bal. Acc.\": round(bal_acc, 4),\n","        \"Prec.\": round(prec, 4),\n","        \"Recall\": round(recall, 4),\n","        \"F1\": round(f1, 4),\n","        \"ROC-AUC\": round(auc, 4) if auc is not None else \"N/A\",\n","    }\n","\n","    return model, metrics, {\"y_test\": y_test, \"y_pred_prob\": y_pred_prob}"]},{"cell_type":"markdown","id":"7e7a8eee","metadata":{"papermill":{"duration":0.003131,"end_time":"2026-10-03T17:11:01.072491+00:00","exception":false,"start_time":"2026-10-03T17:11:01.06936+00:00","status":"completed"},"tags":[]},"source":["### Decision Tree Classifer, Pruned Decision Tree, Random Forest, ExtraTrees, XGBoost, LightGBM, CatBoost (Baseline Testing, default parameters)"]},{"cell_type":"code","execution_count":11,"id":"28d46d7e","metadata":{"execution":{"iopub.execute_input":"2026-10-03T17:11:01.081113Z","iopub.status.busy":"2026-10-03T17:11:01.080639Z","iopub.status.idle":"2026-10-03T17:11:01.08993Z","shell.execute_reply":"2026-10-03T17:11:01.088827Z"},"papermill":{"duration":0.016308,"end_time":"2026-10-03T17:11:01.092042+00:00","exception":false,"start_time":"2026-10-03T17:11:01.075734+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["base_models = {\n","        \"Baseline Tree\": DecisionTreeClassifier(random_state=42),\n","        \"Pruned Tree\": DecisionTreeClassifier(max_depth=10, min_samples_leaf=5, random_state=42),\n","        \"Random Forest\": RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1),\n","        \"Extra Trees\": ExtraTreesClassifier(n_estimators=100, random_state=42, n_jobs=-1),\n","        \"XGBoost\": XGBClassifier(n_estimators=100, learning_rate=0.1, random_state=42, eval_metric=\"logloss\"),\n","        \"LightGBM\": LGBMClassifier(n_estimators=100, learning_rate=0.1, random_state=42, n_jobs=-1, verbosity=-1),\n","        \"CatBoost\": CatBoostClassifier(iterations=300, learning_rate=0.1, random_seed=42, verbose=0)\n","}"]},{"cell_type":"code","execution_count":12,"id":"44b9bc1f","metadata":{"execution":{"iopub.execute_input":"2026-10-03T17:11:01.101747Z","iopub.status.busy":"2026-10-03T17:11:01.100711Z","iopub.status.idle":"2026-10-03T17:11:01.114346Z","shell.execute_reply":"2026-10-03T17:11:01.113127Z"},"papermill":{"duration":0.020657,"end_time":"2026-10-03T17:11:01.116349+00:00","exception":false,"start_time":"2026-10-03T17:11:01.095692+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def evaluate_models(models, X_train, y_train, X_valid, y_valid):\n","    fit_results = []\n","    \n","    for name, model in models.items():\n","        model.fit(X_train, y_train)\n","        \n","        # Predict classes\n","        y_train_pred = model.predict(X_train)\n","        y_valid_pred = model.predict(X_valid)\n","        \n","        # Predict probabilities for ROC-AUC\n","        y_train_prob = model.predict_proba(X_train)[:, 1]\n","        y_valid_prob = model.predict_proba(X_valid)[:, 1]\n","        \n","        # Calculate scores\n","        train_acc = accuracy_score(y_train, y_train_pred)\n","        valid_acc = accuracy_score(y_valid, y_valid_pred)\n","        train_auc = roc_auc_score(y_train, y_train_prob)\n","        valid_auc = roc_auc_score(y_valid, y_valid_prob)\n","        \n","        fit_results.append({\n","            \"Model\": name,\n","            \"Train Acc\": round(train_acc, 4),\n","            \"Valid Acc\": round(valid_acc, 4),\n","            \"Acc Gap\": round(train_acc - valid_acc, 4),\n","            \"Train ROC-AUC\": round(train_auc, 4),\n","            \"Valid ROC-AUC\": round(valid_auc, 4),\n","            \"AUC Gap\": round(train_auc - valid_auc, 4)\n","        })\n","    \n","    fit_df = pd.DataFrame(fit_results)\n","    display(fit_df)\n","    \n","    # 3. Plot Train vs Validation Comparison\n","    x = np.arange(len(fit_df[\"Mo